{
  "$defs": {
    "AgentIdentity": {
      "additionalProperties": false,
      "description": "The managed Pi execution that produced or received a message. `subject_id` is\nthe address that survives replacement; the rest is provenance for the\nexecution that acted.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "registration_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        }
      },
      "required": [
        "registration_id",
        "session_id",
        "subject_id",
        "claim_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One recipient's durable capture. Stored separately from content, and it\nmeans only that: not delivery, not understanding, not settlement.",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "received_at_unix_ms": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "recipient": {
      "$ref": "#/$defs/AgentIdentity"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "message_id",
    "recipient",
    "received_at_unix_ms"
  ],
  "title": "message-receipt-deserialize",
  "type": "object"
}
