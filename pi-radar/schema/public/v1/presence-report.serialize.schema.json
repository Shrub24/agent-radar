{
  "$defs": {
    "ProcessIdentity": {
      "additionalProperties": false,
      "description": "Which process incarnation a sample belongs to.\n\nThe kernel reuses process ids, so a pid does not name a process: one\nincarnation is the boot it started in, its pid, and when it started. Those\nare what make two readings comparable — counters may only be subtracted\nfrom an earlier reading of the same identity, and a difference taken across\ntwo of them measures neither process.",
      "properties": {
        "boot_id": {
          "description": "The boot this process started in, as the kernel reports it.",
          "type": "string"
        },
        "pid": {
          "description": "The process id, unique within one boot and one incarnation of it.",
          "format": "int32",
          "type": "integer"
        },
        "start_ticks": {
          "description": "Start time since boot, in clock ticks (`starttime` in\n`/proc/<pid>/stat`): the kernel's stamp for this incarnation.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "boot_id",
        "pid",
        "start_ticks"
      ],
      "type": "object"
    },
    "RegistryLocation": {
      "additionalProperties": false,
      "description": "Where an agent's incarnation lives on one backend, in that backend's own\ncoordinates.\n\nThe backend name is free-form so a source Radar does not ship yet is\npreserved rather than rejected; the rest are the coordinates as reported, and\neach is optional because a backend need not name every level.",
      "properties": {
        "backend": {
          "type": "string"
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "pane": {
          "type": [
            "string",
            "null"
          ]
        },
        "tab": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backend"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "incarnation": {
      "type": "string"
    },
    "label": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "owner": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "process": {
      "$ref": "#/$defs/ProcessIdentity"
    },
    "registration_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "run": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "source",
    "incarnation",
    "process",
    "session_id",
    "claim_id",
    "registration_id",
    "subject_id",
    "location",
    "owner",
    "run",
    "label"
  ],
  "title": "presence-report-serialize",
  "type": "object"
}
