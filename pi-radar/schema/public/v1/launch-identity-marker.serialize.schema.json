{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A non-secret Pi-session breadcrumb issued by Radar. This is correlation\nevidence only and cannot establish lifecycle authority.",
  "properties": {
    "execution_generation": {
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 1,
      "type": "integer"
    },
    "launch_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "subject_id",
    "launch_id",
    "execution_generation"
  ],
  "title": "launch-identity-marker-serialize",
  "type": "object"
}
